<?xml version="1.0" encoding="UTF-8"?>

<node name="/org/xfce/PowerManager">
    <interface name="org.xfce.Power.Manager">
     
    <method name="Quit">
    </method>
    
    <method name="Restart">
    </method>
    
    <method name="GetConfig">
	<arg direction="out" name="config" type="a{ss}"/>
    </method>
    
    <method name="GetInfo">
	<arg direction="out" name="name" type="s"/>
        <arg direction="out" name="version" type="s"/>
        <arg direction="out" name="vendor" type="s"/>
    </method>

    <!-- Screen brightness in percent of the maximum level (0-100).
         Both fail with NoHardwareSupport when there is no backlight. -->
    <method name="GetBrightness">
        <arg direction="out" name="percent" type="i"/>
    </method>

    <method name="SetBrightness">
        <arg direction="in" name="percent" type="i"/>
    </method>
	
    </interface>
</node>
